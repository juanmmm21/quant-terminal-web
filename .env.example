# quant-terminal-web — copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Operator bearer token for the control endpoints (kill switch, pause, promotion, devices).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = control endpoints disabled (503).
TERMINAL_ADMIN_TOKEN=

# Binance spot TESTNET keys (https://testnet.binance.vision). Test funds only.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Paper trading
TERMINAL_PAPER_VENUE=testnet
TERMINAL_PAPER_QUANTITY=0.001
TERMINAL_PAPER_MAX_POSITION=0.01
TERMINAL_PAPER_MAX_ORDER_NOTIONAL=1000
TERMINAL_PAPER_INTERVAL_SECONDS=10

# Promotion gate (see README): enforce | acknowledge
TERMINAL_PAPER_GATE_MODE=enforce

# Paths inside the container (the docker compose volume is mounted at /app/data)
TERMINAL_PROJECT_ROOT=/app
TERMINAL_CANDLE_SYMBOL=BTCUSDT

# APNs (iOS push alerts) — optional, see the quant-terminal-ios README.
# The .p8 key file is mounted read-only; its contents never go in this file.
TERMINAL_APNS_KEY_PATH=
TERMINAL_APNS_KEY_ID=
TERMINAL_APNS_TEAM_ID=
TERMINAL_APNS_TOPIC=
